  language: 1
  font: {fileID: 11400000, guid: 8256bbb1cf65da5488872b2be69343da, type: 2}
  subtitleCharsPerLine: 22
  strings:
  - key: label.normal
    value: "\u6B63\u5E38\u5FC3\u810F"
  - key: label.hypertensive
    value: "\u9AD8\u8840\u538B\u6027\u5FC3\u810F"
  - key: label.ischemic
    value: "\u7F3A\u8840\u6027\u5FC3\u810F"
  - key: label.athletic
    value: "\u8FD0\u52A8\u5458\u5FC3\u810F"
  - key: label.press_esc_to_return_to_menu
    value: "\u6309 Esc \u952E\u8FD4\u56DE\u4E3B\u83DC\u5355"
  - key: label.smooth_steady_strong
    value: "\u987A\u7545\n\u5E73\u7A33\n\u6709\u529B"
  - key: label.normal_heart
    value: "\u6B63\u5E38\u5FC3\u810F"
  - key: label.lets_get_started
    value: "\u5F00\u59CB\u4F53\u9A8C"
  - key: label.new_experience
    value: "\u91CD\u65B0\u5F00\u59CB"
  - key: label.resume
    value: "\u7EE7\u7EED"
  - key: label.connect_left_hexr
    value: "\u8BF7\u8FDE\u63A5\u5DE6\u624B HexR"
  - key: label.connect_right_hexr
    value: "\u8BF7\u8FDE\u63A5\u53F3\u624B HexR"
  narrations:
  - key: narration.normal.1
    clip: {fileID: 8300000, guid: 8a040d612fef4587b1b8e94aa651a94e, type: 3}
    subtitleFile: {fileID: 0}
    lines:
    - text: "\u6B22\u8FCE\uFF01\u4ECA\u5929\uFF0C\u6211\u4EEC\u5C06\u4E00\u8D77\u8E0F\u4E0A\u4E00\u6BB5\u65C5\u7A0B\uFF0C\u53BB\u8BA4\u8BC6\u4EBA\u7C7B\u7684\u5FC3\u810F\u3002"
      startTime: 0.5
    - text: "\u4F60\u53EF\u4EE5\u628A\u5B83\u60F3\u8C61\u6210\u4E00\u6B21\u535A\u7269\u9986\u5BFC\u89C8\u2014\u2014\u5728\u8FD9\u91CC\uFF0C\u4F60\u4E0D\u4EC5\u80FD\u770B\u89C1\uFF0C\u8FD8\u80FD\u4EB2\u624B\u611F\u53D7\u5FC3\u810F\u662F\u5982\u4F55\u5DE5\u4F5C\u7684\u3002"
      startTime: 7.1
    - text: "\u5728\u4E86\u89E3\u5404\u79CD\u5FC3\u810F\u75BE\u75C5\u4E4B\u524D\uFF0C\u5148\u6765\u8BA4\u8BC6\u4E00\u9897\u5065\u5EB7\u7684\u5FC3\u810F\u2014\u2014\u5B83\u662F\u6211\u4EEC\u90FD\u5E0C\u671B\u5B88\u62A4\u7684\u201C\u9EC4\u91D1\u6807\u51C6\u201D\u3002"
      startTime: 17.5
    - text: "\u8FD9\u5C31\u662F\u5B83\u2014\u2014\u5F3A\u5065\u800C\u6B63\u5E38\u7684\u5FC3\u810F\u3002\u5B83\u6BCF\u5929\u5927\u7EA6\u8DF3\u52A8\u5341\u4E07\u6B21\uFF0C\u4ECE\u4E0D\u4F11\u606F\u3002"
      startTime: 27.8
    - text: "\u4F38\u51FA\u624B\uFF0C\u89E6\u78B0\u5B83\u5427\u3002"
      startTime: 35.3
  - key: narration.normal.2
    clip: {fileID: 8300000, guid: 90b50abcba834f3b87aaf85273ba4e43, type: 3}
    subtitleFile: {fileID: 0}
    lines:
    - text: "\u611F\u89C9\u5230\u4E86\u5417\uFF1F\u8FD9\u5C31\u662F\u751F\u547D\u7684\u8282\u594F\u2014\u2014\u987A\u7545\u3001\u5E73\u7A33\u3001\u6709\u529B\u3002"
      startTime: 0.5
    - text: "\u5065\u5EB7\u7684\u5FC3\u810F\u5C31\u50CF\u4E00\u53F0\u53EF\u9760\u7684\u6CF5\uFF0C\u6BCF\u4E00\u6B21\u8DF3\u52A8\u90FD\u628A\u8840\u6DB2\u548C\u6C27\u6C14\u9001\u5F80\u5168\u8EAB\u3002"
      startTime: 6.8
    - text: "\u800C\u4ECA\u5929\u6700\u91CD\u8981\u7684\u4E00\u70B9\u662F\u2014\u2014"
      startTime: 14.6
    - text: "\u4F60\u7684\u751F\u6D3B\u65B9\u5F0F\uFF0C\u51B3\u5B9A\u4E86\u5B83\u80FD\u5426\u4E00\u76F4\u4FDD\u6301\u8FD9\u6837\uFF0C\u8FD8\u662F\u4F1A\u9010\u6E10\u53D8\u5DEE\u3002"
      startTime: 17.6
    - text: "\u8BA9\u6211\u4EEC\u770B\u770B\uFF0C\u65E5\u5E38\u7684\u9009\u62E9\u4F1A\u5982\u4F55\u6539\u53D8\u4F60\u7684\u5FC3\u810F\u3002"
      startTime: 24.6
  - key: narration.hypertensive.1
    clip: {fileID: 8300000, guid: 7dfe7c98b31f47909ea09a3a1ef6f90f, type: 3}
    subtitleFile: {fileID: 0}
    lines:
    - text: "\u4ED4\u7EC6\u770B\u2014\u2014\u5FC3\u810F\u5DF2\u7ECF\u6539\u53D8\u4E86\u3002\u5B83\u7684\u5FC3\u58C1\u53D8\u539A\u4E86\uFF0C\u5149\u6CFD\u4E5F\u53D8\u5F31\u4E86\uFF0C"
      startTime: 0.5
    - text: "\u8DF3\u52A8\u770B\u4F3C\u66F4\u7528\u529B\uFF0C\u5374\u4E0D\u518D\u90A3\u4E48\u7075\u6D3B\u3002\u8FD9\u5C31\u662F\u9AD8\u8840\u538B\u6027\u5FC3\u810F\u7684\u53D8\u5316\u3002"
      startTime: 6.9
    - text: "\u4E0D\u5065\u5EB7\u7684\u996E\u98DF\u2014\u2014\u8FC7\u591A\u7684\u76D0\u3001\u7CD6\u548C\u8102\u80AA\u2014\u2014\u518D\u52A0\u4E0A\u80A5\u80D6\uFF0C\u4F1A\u8FEB\u4F7F\u5FC3\u810F\u957F\u671F\u8D85\u8D1F\u8377\u5DE5\u4F5C\u3002"
      startTime: 13.6
    - text: "\u9AD8\u8840\u538B\u4F1A\u8BA9\u5FC3\u808C\u53D8\u5F97\u80A5\u539A\uFF0C\u5C31\u50CF\u4E3E\u91CD\u4F1A\u8BA9\u624B\u81C2\u53D8\u7C97\u4E00\u6837\u3002"
      startTime: 22.4
    - text: "\u4F46\u548C\u5F3A\u58EE\u7684\u624B\u81C2\u4E0D\u540C\uFF0C\u50F5\u786C\u7684\u5FC3\u810F\u5E76\u4E0D\u662F\u597D\u6D88\u606F\u3002"
      startTime: 28.1
    - text: "\u6765\uFF0C\u4F38\u624B\u89E6\u78B0\u8FD9\u9897\u9AD8\u8840\u538B\u6027\u5FC3\u810F\u3002"
      startTime: 33.2
    - text: "\u611F\u53D7\u4E00\u4E0B\uFF0C\u5B83\u548C\u5065\u5EB7\u7684\u5FC3\u810F\u6709\u4EC0\u4E48\u4E0D\u540C\u3002"
      startTime: 36.6
  - key: narration.hypertensive.2
    clip: {fileID: 8300000, guid: 5b251712c4004c659f7c34865b64cefd, type: 3}
    subtitleFile: {fileID: 0}
    lines:
    - text: "\u611F\u89C9\u5230\u4E86\u5417\uFF1F\u5F39\u6027\u66F4\u5C11\uFF0C\u8D1F\u62C5\u66F4\u91CD\u3002\u8FD9\u5C31\u662F\u9AD8\u8840\u538B\u5E26\u6765\u7684\u65E0\u58F0\u538B\u529B\u3002"
      startTime: 0.5
    - text: "\u5927\u591A\u6570\u4EBA\u76F4\u5230\u635F\u5BB3\u5DF2\u7ECF\u53D1\u751F\uFF0C\u624D\u4F1A\u5BDF\u89C9\u3002"
      startTime: 8.1
    - text: "\u5F53\u5FC3\u58C1\u53D8\u5F97\u8FC7\u539A\uFF0C\u5185\u90E8\u7684\u5FC3\u8154\u5C31\u4F1A\u53D8\u5C0F\uFF0C\u6BCF\u6B21\u8DF3\u52A8\u80FD\u6CF5\u51FA\u7684\u8840\u6DB2\u4E5F\u968F\u4E4B\u51CF\u5C11\u3002"
      startTime: 12.7
    - text: "\u4E45\u800C\u4E45\u4E4B\uFF0C\u8FD9\u4F1A\u589E\u52A0\u5FC3\u529B\u8870\u7AED\u3001\u4E2D\u98CE\u548C\u80BE\u810F\u75BE\u75C5\u7684\u98CE\u9669\u3002"
      startTime: 21.4
    - text: "\u597D\u6D88\u606F\u662F\uFF1A\u6539\u53D8\u751F\u6D3B\u65B9\u5F0F\u2014\u2014\u5C11\u5403\u76D0\u3001\u5403\u5F97\u66F4\u5065\u5EB7\u3001\u575A\u6301\u8FD0\u52A8\u2014\u2014"
      startTime: 27.8
    - text: "\u53EF\u4EE5\u964D\u4F4E\u8840\u538B\uFF0C\u8BA9\u5FC3\u810F\u4FDD\u6301\u5F39\u6027\u4E0E\u529B\u91CF\u3002"
      startTime: 35.2
    - text: "\u73B0\u5728\uFF0C\u6211\u4EEC\u518D\u6765\u8BD5\u8BD5\u53E6\u4E00\u79CD\u751F\u6D3B\u65B9\u5F0F\u5427\u3002"
      startTime: 39.8
  - key: narration.ischemic.1
    clip: {fileID: 8300000, guid: e6b06f12df4a446c8f64aaeb408d03e8, type: 3}
    subtitleFile: {fileID: 0}
    lines:
    - text: "\u770B\u770B\u957F\u671F\u5438\u70DF\u4E4B\u540E\uFF0C\u5FC3\u810F\u53D1\u751F\u4E86\u600E\u6837\u7684\u53D8\u5316\u3002"
      startTime: 0.5
    - text: "\u6CE8\u610F\u8FD9\u4E9B\u4E0D\u5747\u5300\u7684\u533A\u57DF\uFF0C\u6709\u4E9B\u90E8\u5206\u6BD4\u5176\u4ED6\u5730\u65B9\u66F4\u6697\u6DE1\u3002"
      startTime: 5.5
    - text: "\u8FD9\u4EE3\u8868\u7740\u8840\u6D41\u53D7\u963B\u9020\u6210\u7684\u635F\u4F24\u3002"
      startTime: 11.5
    - text: "\u8FD9\u53EB\u505A\u7F3A\u8840\u6027\u5FC3\u810F\u3002\u5438\u70DF\u4F1A\u635F\u5BB3\u8840\u7BA1\uFF0C"
      startTime: 15
    - text: "\u4FC3\u4F7F\u6591\u5757\u5806\u79EF\uFF0C\u5E76\u51CF\u5C11\u5FC3\u808C\u7684\u4F9B\u6C27\u3002"
      startTime: 19.2
    - text: "\u65F6\u95F4\u4E00\u957F\uFF0C\u6709\u4E9B\u533A\u57DF\u4F1A\u53D8\u5F97\u865A\u5F31\uFF0C\u751A\u81F3\u574F\u6B7B\uFF0C\u7559\u4E0B\u75A4\u75D5\u3002"
      startTime: 23.2
    - text: "\u6765\uFF0C\u4F38\u624B\u89E6\u78B0\u8FD9\u9897\u7F3A\u8840\u6027\u5FC3\u810F\uFF0C\u4EB2\u81EA\u611F\u53D7\u5176\u4E2D\u7684\u4E0D\u540C\u3002"
      startTime: 29.5
  - key: narration.ischemic.2
    clip: {fileID: 8300000, guid: 72490c3b01784d11a8720d6e58e79149, type: 3}
    subtitleFile: {fileID: 0}
    lines:
    - text: "\u611F\u89C9\u5230\u4E86\u5417\uFF1F\u5FC3\u8DF3\u53D8\u5F97\u4E0D\u89C4\u5F8B\u3001\u96BE\u4EE5\u9884\u6D4B\uFF0C\u67D0\u4E9B\u90E8\u4F4D\u4E5F\u66F4\u52A0\u5FAE\u5F31\u3002"
      startTime: 0.5
    - text: "\u8FD9\u6B63\u662F\u7F3A\u8840\u6027\u5FC3\u810F\u7684\u5178\u578B\u7279\u5F81\u3002\u5B83\u53EF\u80FD\u5F15\u53D1\u80F8\u75DB\u3001"
      startTime: 7.9
    - text: "\u5FC3\u810F\u75C5\u53D1\u4F5C\uFF0C\u5982\u679C\u8840\u6D41\u5F97\u4E0D\u5230\u6062\u590D\uFF0C\u751A\u81F3\u4F1A\u5BFC\u81F4\u5FC3\u529B\u8870\u7AED\u3002"
      startTime: 13.4
    - text: "\u597D\u6D88\u606F\u662F\uFF0C\u6212\u70DF\u3001\u5065\u5EB7\u996E\u98DF\u548C\u575A\u6301\u8FD0\u52A8\uFF0C\u53EF\u4EE5\u9632\u6B62\u8FDB\u4E00\u6B65\u7684\u635F\u4F24\uFF0C\u5E76\u6539\u5584\u5FC3\u810F\u529F\u80FD\u3002"
      startTime: 20
    - text: "\u73B0\u5728\uFF0C\u6211\u4EEC\u518D\u6765\u8BD5\u8BD5\u53E6\u4E00\u79CD\u751F\u6D3B\u65B9\u5F0F\u5427\u3002"
      startTime: 29.4
  - key: narration.athletic.1
    clip: {fileID: 8300000, guid: 241366c7c81a4908962669a59db92051, type: 3}
    subtitleFile: {fileID: 0}
    lines:
    - text: "\u73B0\u5728\u6765\u770B\u770B\uFF0C\u5F53\u6211\u4EEC\u901A\u8FC7\u89C4\u5F8B\u8FD0\u52A8\u6765\u5475\u62A4\u5FC3\u810F\u65F6\uFF0C\u4F1A\u53D1\u751F\u4EC0\u4E48\u3002"
      startTime: 0.5
    - text: "\u6CE8\u610F\u8FD9\u9897\u5FC3\u810F\u7A0D\u5FAE\u5927\u4E00\u4E9B\uFF0C\u5149\u6CFD\u660E\u4EAE\uFF0C\u8DF3\u52A8\u5F3A\u52B2\u800C\u9AD8\u6548\u3002"
      startTime: 7.2
    - text: "\u8FD9\u6709\u65F6\u88AB\u79F0\u4E3A\u201C\u8FD0\u52A8\u5458\u5FC3\u810F\u201D\u3002\u4E0E\u56E0\u538B\u529B\u800C\u53D8\u5F97\u50F5\u786C\u7684\u9AD8\u8840\u538B\u6027\u5FC3\u810F\u4E0D\u540C\uFF0C"
      startTime: 13.1
    - text: "\u8FD0\u52A8\u5458\u5FC3\u810F\u4F1A\u53D8\u5F97\u66F4\u5F3A\u58EE\u3001\u66F4\u9AD8\u6548\u3002"
      startTime: 21
    - text: "\u6765\uFF0C\u4F38\u624B\u89E6\u78B0\u8FD9\u9897\u8FD0\u52A8\u5458\u5FC3\u810F\uFF0C\u4EB2\u81EA\u611F\u53D7\u5176\u4E2D\u7684\u4E0D\u540C\u3002"
      startTime: 24.8
  - key: narration.athletic.2
    clip: {fileID: 8300000, guid: deef32a239984321b5bc3e9dd4d95c66, type: 3}
    subtitleFile: {fileID: 0}
    lines:
    - text: "\u611F\u89C9\u5230\u4E86\u5417\uFF1F\u66F4\u6709\u529B\u91CF\uFF0C\u4F46\u4F9D\u7136\u987A\u7545\u5E73\u7A33\u3002"
      startTime: 0.5
    - text: "\u8FD9\u6B63\u662F\u4E00\u9897\u8BAD\u7EC3\u6709\u7D20\u3001\u5065\u5EB7\u5FC3\u810F\u7684\u6807\u5FD7\u3002"
      startTime: 4.8
    - text: "\u89C4\u5F8B\u8FD0\u52A8\u80FD\u8BA9\u5FC3\u810F\u6CF5\u8840\u66F4\u9AD8\u6548\uFF0C\u964D\u4F4E\u8840\u538B\uFF0C\u6539\u5584\u8840\u6DB2\u5FAA\u73AF\uFF0C\u5E76\u9884\u9632\u5FC3\u810F\u75BE\u75C5\u3002"
      startTime: 8.8
    - text: "\u6BCF\u5929\u53EA\u8981\u4E09\u5341\u5206\u949F\u7684\u8FD0\u52A8\uFF0C\u5C31\u80FD\u5E26\u6765\u4E00\u751F\u7684\u6539\u53D8\u3002"
      startTime: 16.4
    - text: "\u73B0\u5728\uFF0C\u6211\u4EEC\u518D\u6765\u8BD5\u8BD5\u53E6\u4E00\u79CD\u751F\u6D3B\u65B9\u5F0F\u5427\u3002"
      startTime: 21.4
  - key: narration.completed
    clip: {fileID: 8300000, guid: dbe46d69219f426fa99efef78058d5c5, type: 3}
    subtitleFile: {fileID: 0}
    lines:
    - text: "\u73B0\u5728\uFF0C\u4F60\u5DF2\u7ECF\u4E86\u89E3\u4E86\u751F\u6D3B\u65B9\u5F0F\u5982\u4F55\u8BA9\u5FC3\u810F\u53D8\u5F31\uFF0C\u6216\u53D8\u5F97\u66F4\u5F3A\u3002"
      startTime: 0.5
    - text: "\u63A5\u4E0B\u6765\uFF0C\u4F60\u53EF\u4EE5\u81EA\u7531\u63A2\u7D22\u3002\u518D\u6B21\u89E6\u78B0\u6BCF\u4E00\u9897\u5FC3\u810F\uFF0C\u6BD4\u8F83\u5B83\u4EEC\u7684\u611F\u89C9\uFF0C"
      startTime: 6.7
    - text: "\u60F3\u4E00\u60F3\u662F\u54EA\u4E9B\u9009\u62E9\u9020\u5C31\u4E86\u5B83\u4EEC\u3002"
      startTime: 13.7
    - text: "\u8BF7\u8BB0\u4F4F\u2014\u2014\u4F60\u4ECA\u5929\u7167\u987E\u7684\u8FD9\u9897\u5FC3\u810F\uFF0C\u5C06\u966A\u4F60\u8D70\u5411\u660E\u5929\u3002"
      startTime: 16.9
  - key: narration.sad
    clip: {fileID: 8300000, guid: b0a03a227b66441584ab60e932845528, type: 3}
    subtitleFile: {fileID: 0}
    lines:
    - text: "\u563F\uFF0C\u80FD\u522B\u518D\u628A\u6211\u7684\u5FC3\u810F\u4E22\u5F00\u4E86\u5417\uFF1F\u6211\u4F1A\u96BE\u8FC7\u7684\u3002"
      startTime: 0.3
